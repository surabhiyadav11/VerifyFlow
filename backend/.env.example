# Application
APP_NAME=VerifyFlow
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/verifyflow

# Providers
OCR_PROVIDER=tesseract
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & Retention
ID_HASH_SECRET=change-me-in-local-env
KYC_RETENTION_DAYS=7

